{
    "name": "hideyukimori/nene-clear",
    "description": "NeNe Clear — self-hosted payment reconciliation and dunning (入金消込・督促管理) on NENE2.",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": ">=8.4.1 <9.0",
        "hideyukimori/nene2": "@dev"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.95",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^13.1",
        "symfony/yaml": "^8.0"
    },
    "autoload": {
        "psr-4": {
            "NeneClear\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "NeneClear\\Tests\\": "tests/"
        }
    },
    "repositories": [
        {
            "type": "path",
            "url": "../NENE2",
            "options": {
                "symlink": true
            }
        }
    ],
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "php-http/discovery": false
        }
    },
    "scripts": {
        "test": "phpunit",
        "analyse": "phpstan analyse --memory-limit 512M",
        "cs": "php-cs-fixer check --diff --allow-risky=yes --config=.php-cs-fixer.php",
        "cs:fix": "php-cs-fixer fix --allow-risky=yes --config=.php-cs-fixer.php",
        "check": [
            "@test",
            "@analyse",
            "@cs"
        ]
    }
}
