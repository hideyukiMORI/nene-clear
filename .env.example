APP_ENV=local
APP_DEBUG=false
APP_NAME="NeNe Clear"

# Problem Details base URI for this product.
PROBLEM_DETAILS_BASE_URL=https://nene-clear.dev/problems/

# NeNe Invoice upstream (read invoices, write payments on confirmed match).
# See docs/integrations/invoice-upstream-contract.md. Secret stays here only.
NENE_INVOICE_API_BASE_URL=
NENE_INVOICE_BEARER_TOKEN=

# Database (Phase 1+). sqlite for local/dev and tests.
DB_ADAPTER=sqlite
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=nene_clear
DB_USER=nene_clear
DB_PASSWORD=nene_clear
DB_CHARSET=utf8mb4
